{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // The browser entry and its runtime, built by tsconfig.browser.json.
  "exclude": ["src/browser.ts", "src/browser-runtime.ts", "src/worker-common.ts", "src/worker-single.ts", "src/worker-threaded.ts", "src/worker-protocol.ts", "src/wasm-glue.d.ts"]
}
